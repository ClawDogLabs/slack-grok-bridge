# Copy to wrangler.toml (git-ignored) and fill in. Never put secrets in this file.
name = "slack-bridge-example"
main = "src/index.js"
compatibility_date = "2026-10-01"
# account_id = "<your-cloudflare-account-id>"   # or export CLOUDFLARE_ACCOUNT_ID
workers_dev = true                               # https://slack-bridge-example.<your-subdomain>.workers.dev

[observability]
enabled = true

# Non-secret config. Mirrors the bridge's .env where the names match.
[vars]
BRIDGE_SOURCE = "slack-grok-bridge"   # "source" field sent to the Grok webhook
ACK_REACTION = "white_check_mark"     # emoji name, no colons; "off" disables. Needs reactions:write.
                                      # a missing custom emoji falls back to white_check_mark
HOLD_ACK = "false"                    # "true" = also post the text hold-ack (opt-in)
HOLD_ACK_BROADCAST = "true"           # when HOLD_ACK is on, also send that text to the channel
OWNER_DISPLAY_NAME = ""               # used in hold-ack / thinking text ("the owner" if empty)
PERSONAL_NAMES = ""                   # comma-separated names that trigger the stronger privacy hold-ack
ALLOW_BOT_IDS = ""                    # other bots allowed to @mention this bot (B...), comma-separated
ALLOW_BOT_USER_IDS = ""               # same, by bot user id (U...)
BOT_REPLY_CAP = "3"                   # ignore an allow-listed bot after it has posted more than this
                                      # many messages in one thread. Humans are never capped; a top-level
                                      # bot message is always allowed. If the thread can't be read, further
                                      # bot mentions there are ignored. conversations.replies uses history
                                      # scopes the app already has (channels:history, groups:history,
                                      # im:history). Add mpim:history to the manifest only for group DMs;
                                      # without it those bot threads fail closed.

# Optional. Leave empty to have the Worker look these up once with auth.test.
OWN_USER_ID = ""                      # this bot's user id (U...)
OWN_BOT_ID = ""                       # this bot's bot id (B...)

# Optional extras (off when empty / false):
HOLD_ACK_SKIP_REGEX = ""              # JS regex (case-insensitive); matching asks get no text hold-ack
BOT_NAME = ""                         # e.g. "mybot"; plain-text name that counts as addressing the bot
MPIM_REQUIRE_ADDRESS = "false"        # "true" = in group DMs only wake when @mentioned or BOT_NAME appears
WATCH_CHANNEL_IDS = ""                # channels (C...) to forward WITHOUT an @mention, as kind "channel_message"
WELCOME_CHANNEL_IDS = ""              # channels (C...) where new joiners get a :wave: + WELCOME_TEXT
ASK_CHANNEL_ID = ""                   # channel referenced as {ask_channel} in WELCOME_TEXT
WELCOME_TEXT = ""                     # placeholders {user} and {ask_channel}; a generic default is used if empty
RETRY_POLICY = "drop_timeouts"        # drop_timeouts | drop_all | process_all (see README)

# Mute. Comma-separated channel ids. HTTP 200 and nothing else: no reaction
# (including a custom ack emoji), no thinking status, no hold-ack, no welcome,
# no Grok wake, no Honcho write. Edits, joins, threads, and retries included.
# Does not enable recording. Do not also list these ids in HONCHO_CHANNEL_IDS.
SILENT_CHANNEL_IDS = ""
# Isolated record for SILENT_CHANNEL_IDS only. Default off. Do not set "1" until
# the mute is deployed from the runtime source, message.groups and groups:history
# are verified, and a tail shows honcho record ok (not a public peer id).
SILENT_RECORD = "0"
# Who may run an explicit history search in a 1:1 DM. Not attached to wakes.
# Format: CHANNEL:USER|USER,CHANNEL2:USER  (pipe inside a channel, comma between channels)
SILENT_CHANNEL_READERS = ""
# Names that count as naming the channel in that search. Same CHANNEL:alias|alias shape.
SILENT_CHANNEL_ALIASES = ""
# Slack user ids allowed to call the owner-Grok scoped read. Empty = nobody.
SILENT_GROK_READER_IDS = ""

# Honcho phase A. Default off. "1" writes public-channel messages after the Slack ack.
# DMs, group DMs, and private channels are not written. Ingest does not read Honcho.
HONCHO_INGEST = "0"
HONCHO_WORKSPACE_ID = "slack-workspace"
# Public channel ids used when channel_type is missing and conversations.info
# cannot classify (no channels:read). Empty = fail closed. Not a secret.
HONCHO_CHANNEL_IDS = ""

# Optional wake-path Honcho context. Default off. Independent of HONCHO_INGEST.
# When "1", processInbound/forwardWatched await session context and attach payload.honcho.
HONCHO_READ = "0"
HONCHO_READ_TIMEOUT_MS = "1500"

# Secrets (set with `npx wrangler secret put NAME`, never in this file):
#   SLACK_SIGNING_SECRET, SLACK_BOT_TOKEN, GROK_WEBHOOK_URL, GROK_WEBHOOK_SECRET,
#   HONCHO_API_KEY   (needed when HONCHO_INGEST or HONCHO_READ is "1")
