# Slack app for your Grok Bot on ClawDogLabs — never commit real values
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# App-Level Token with connections:write (xapp-...)
SLACK_APP_TOKEN=
# Signing secret (optional for Socket Mode; keep if you add HTTP later)
SLACK_SIGNING_SECRET=

# Grok Bot inbound webhook URL for THIS agent (from routines / webhook trigger)
GROK_WEBHOOK_URL=
# Optional sender key if your webhook requires it
GROK_WEBHOOK_SECRET=
