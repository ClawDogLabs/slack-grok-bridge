# Slack bot (Socket Mode) — never commit real values
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Grok Bot inbound webhook for THIS agent
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SECRET=

# Optional bridge behavior
BRIDGE_SOURCE=slack-grok-bridge
# Reaction acknowledgement (emoji name, no colons). "off" disables.
# A missing custom emoji falls back to white_check_mark. Needs reactions:write.
ACK_REACTION=white_check_mark
# Text hold-ack is opt-in. The reaction above is the default acknowledgement.
HOLD_ACK=false
HOLD_ACK_BROADCAST=true
THINKING_TIMEOUT_MS=45000
OWNER_DISPLAY_NAME=
# Comma-separated names (family, kids, etc.) that should trigger the stronger
# "ask the owner first" hold-ack. Keep real names here, never in index.js.
PERSONAL_NAMES=
# Other bots allowed to @mention this bot (comma-separated). Empty = ignore all bot mentions.
ALLOW_BOT_IDS=
ALLOW_BOT_USER_IDS=

# Honcho memory ingest (phase A). Off unless HONCHO_INGEST=1. Never commit the API key.
# Public channels only. DMs and private channels are dropped.
# Socket Mode does not read Honcho. The HTTP relay has a separate HONCHO_READ switch.
HONCHO_INGEST=0
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=princeton-ai-slack
# Public channel ids (comma-separated). Required for backfill and for live events
# that omit channel_type, until conversations.info works (channels:read).
HONCHO_CHANNEL_IDS=

# Socket Mode reliability (defaults shown). The library default client ping timeout (5000)
# causes constant reconnects on slow/shared hosts.
CLIENT_PING_TIMEOUT_MS=15000
SERVER_PING_TIMEOUT_MS=60000
# Watchdog: exit (supervisor restarts) after the socket is unhealthy this long.
WATCHDOG_MAX_UNHEALTHY_MS=120000
