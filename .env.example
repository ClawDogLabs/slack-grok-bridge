# Slack bot (Socket Mode) — never commit real values
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Grok Bot inbound webhook for THIS agent
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SECRET=

# Optional bridge behavior
BRIDGE_SOURCE=slack-grok-bridge
HOLD_ACK=true
HOLD_ACK_BROADCAST=true
THINKING_TIMEOUT_MS=45000
OWNER_DISPLAY_NAME=
# Comma-separated names (family, kids, etc.) that should trigger the stronger
# "ask the owner first" hold-ack. Keep real names here, never in index.js.
PERSONAL_NAMES=
# Other bots allowed to @mention this bot (comma-separated). Empty = ignore all bot mentions.
ALLOW_BOT_IDS=
ALLOW_BOT_USER_IDS=

# Socket Mode reliability (defaults shown). The library default client ping timeout (5000)
# causes constant reconnects on slow/shared hosts.
CLIENT_PING_TIMEOUT_MS=15000
SERVER_PING_TIMEOUT_MS=60000
# Watchdog: exit (supervisor restarts) after the socket is unhealthy this long.
WATCHDOG_MAX_UNHEALTHY_MS=120000
