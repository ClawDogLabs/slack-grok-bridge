# Same names as the Cloudflare Worker secrets / [vars]. Never commit the real .env.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SECRET=

# Optional (see ../cloudflare-relay/wrangler.toml.example for the full list)
# ACK_REACTION=white_check_mark
# HOLD_ACK=false
# OWNER_DISPLAY_NAME=the owner
# OWN_USER_ID=U0XXXXXXX
# OWN_BOT_ID=B0XXXXXXX
# ALLOW_BOT_IDS=
# ALLOW_BOT_USER_IDS=
# RETRY_POLICY=drop_timeouts
# HONCHO_INGEST=0
# HONCHO_API_KEY=
# HONCHO_WORKSPACE_ID=princeton-ai-slack
# HONCHO_CHANNEL_IDS=

PORT=8080
