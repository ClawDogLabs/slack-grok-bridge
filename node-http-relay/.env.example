# Same names as the Cloudflare Worker secrets / [vars]. Never commit the real .env.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SECRET=

# Optional (see ../cloudflare-relay/wrangler.toml.example for the full list)
# ACK_REACTION=white_check_mark
# HOLD_ACK=false
# OWNER_DISPLAY_NAME=the owner
# OWN_USER_ID=U0XXXXXXX
# OWN_BOT_ID=B0XXXXXXX
# ALLOW_BOT_IDS=
# ALLOW_BOT_USER_IDS=
# Ignore an allow-listed bot after it has posted more than this many messages in a thread.
# Humans are never capped. A top-level bot message is always allowed. If the thread
# can't be read, further bot mentions there are ignored. conversations.replies uses
# history scopes the app already has (channels:history, groups:history, im:history).
# Add mpim:history only for group DMs; without it those bot threads fail closed.
# BOT_REPLY_CAP=3
# RETRY_POLICY=drop_timeouts
# HONCHO_INGEST=0
# HONCHO_API_KEY=
# HONCHO_WORKSPACE_ID=slack-workspace
# HONCHO_CHANNEL_IDS=
# Mute. No reaction, thinking status, hold-ack, wake, or Honcho write.
# Does not enable recording. Do not copy these ids into HONCHO_CHANNEL_IDS.
# SILENT_CHANNEL_IDS=
# SILENT_RECORD=0
# SILENT_CHANNEL_READERS=
# SILENT_CHANNEL_ALIASES=
# SILENT_GROK_READER_IDS=
# HONCHO_READ=0
# HONCHO_READ_TIMEOUT_MS=1500

PORT=8080
